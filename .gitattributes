# Normalise line endings across Windows/macOS/Linux contributors.
* text=auto eol=lf

# Windows-only scripts keep CRLF so Windows PowerShell/cmd parse them reliably.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
