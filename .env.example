# ===========================================================================
#  Education Platform — environment template (Sprint 0)
#  Copy this file to `.env` in the project root and replace every placeholder.
#  The real `.env` is ignored by Git and must never be committed.
#  Docker Compose reads this file automatically; the backend reads it through
#  pydantic-settings (same file, single source of truth for DB credentials).
# ===========================================================================

# --- Application -----------------------------------------------------------
PROJECT_NAME=Education Platform
PROJECT_VERSION=0.2.0
# local | test | staging | production
APP_ENV=local
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Backend HTTP ----------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins
# 5173 = Vite dev server, 4173 = `npm run preview`
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- PostgreSQL ------------------------------------------------------------
# Host/port as seen from the machine running the backend
# (the container publishes this port to localhost).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=edu_platform
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=education_platform

# --- Database connection pool ---------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
DB_READY_TIMEOUT=3

# --- Authentication / JWT ---------------------------------------------------
# REQUIRED. At least 32 characters, never commit a real value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_strong_secret_with_python_secrets
JWT_ALGORITHM=HS256
JWT_ISSUER=education-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
